# __ Discord __
# Bot token from https://discord.com/developers/applications
token=

# Application (client) ID from the same page
id=

# __ Lavalink/Nodelink server __
# Kenium cannot play audio without a running Lavalink server.
# These values must match your Lavalink/Nodelink server's own config.
NODE_HOST=127.0.0.1
NODE_PORT=2333
NODE_PASSWORD=youshallnotpass
NODE_NAME=kenium-node

# Set to true if your Lavalink/Nodelink server uses https/wss
NODE_SECURE=false
